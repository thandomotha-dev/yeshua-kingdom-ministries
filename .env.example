# ============================================
# Yeshua Kingdom Ministries — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Form Submissions (Formspree) ---
# Create a free account at https://formspree.io
VITE_FORMSPREE_CONTACT_ID=your_formspree_form_id
VITE_FORMSPREE_PRAYER_ID=your_formspree_prayer_form_id
VITE_FORMSPREE_MARRIAGE_ID=your_formspree_marriage_form_id
VITE_FORMSPREE_PARTNER_ID=your_formspree_partner_form_id
VITE_FORMSPREE_NEWSLETTER_ID=your_formspree_newsletter_form_id

# --- Bible API ---
# Get a free API key at https://scripture.api.bible
VITE_BIBLE_API_KEY=your_api_bible_key

# --- Analytics (optional) ---
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
# OR Plausible domain (e.g., yeshuakingdom.org)
VITE_PLAUSIBLE_DOMAIN=

# --- reCAPTCHA (optional, for spam protection) ---
VITE_RECAPTCHA_SITE_KEY=
